# Copia este archivo a .env y reemplaza las contraseñas, o ejecuta scripts/iniciar.ps1 o .sh.
DB_HOST=db
DB_PORT=3306
DB_NAME=sistema_votacion
DB_USER=root
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
ADMIN_USER=admin
ADMIN_PASSWORD=admin123456

# Dirección oficial incluida en el botón del correo de credenciales.
APP_URL=https://votacioneslibertad-dehje4gfd6crc2e9.mexicocentral-01.azurewebsites.net

# Horario exclusivo del registro, en America/Guatemala. Formato: AAAA-MM-DD HH:MM:SS.
# Completa ambos valores: vacíos, inválidos o cierre <= apertura mantienen el registro cerrado.
REGISTRO_APERTURA="2027-11-15 14:00:00"
REGISTRO_CIERRE="2027-11-15 18:00:00"

# Apertura de la votación en America/Guatemala (AAAA-MM-DD HH:MM:SS), sin cierre automático.
# Si está vacío o es inválido, no se permite votar.
VOTACION_APERTURA=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
